# XorPay 应用配置（必填）
XORPAY_APP_ID=your_app_id
XORPAY_APP_SECRET=your_app_secret

# 支付通知地址（必填）
XORPAY_NOTIFY_URL=https://your-domain/xorpay/notify

# 支付跳转地址（收银台模式必填）
XORPAY_RETURN_URL=https://your-domain/return

# XorPay API 基础地址（可选，留空使用默认官方地址）
XORPAY_BASE_URL=

# Gin 服务监听地址（可选，默认 :8080）
GIN_ADDR=:8080
